# Copy this file to .env.local, and fill the values
# Local: a file. Production: the url of the service
DATABASE_URL=file:data/trailhead.db
# Only for a hosted libSQL database (Turso)
DATABASE_AUTH_TOKEN=
# A long random key: openssl rand -base64 32
SESSION_SECRET=
# The key of the model: from Google AI Studio
GOOGLE_GENERATIVE_AI_API_KEY=
