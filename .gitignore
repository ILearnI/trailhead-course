# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# end to end tests
/e2e/.auth/
/test-results/
/playwright-report/

# next.js
/.next/
/out/
/handbook/out/
/handbook/.next/

# uploaded files
/uploads

# the local database, but keep the folder
/data/*
!/data/.gitkeep

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# keys and certificates
/certs

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
